# TicketeraOnline Frontend — Environment Variables
# Copy this file to .env and adjust values for your environment.

# Backend API base URL.
#   Development (with Vite proxy): /api
#   Production / direct backend access: https://your-backend-domain.com/api
VITE_API_BASE_URL=/api

# Backend target for the Vite dev proxy.
#   Default: http://localhost:5193 (works for Windows/macOS native dev)
#   WSL2 with repo on the Windows disk (/mnt/*): set to your Windows host IP
#   (e.g. http://172.26.64.1:5193)
#   WSL2 with repo on the native Linux filesystem (~/proyectos): localhost
#   reaches the backend directly — uncomment the line below.
# VITE_API_TARGET=http://localhost:5193

# Cloudflare Turnstile site key (use test key 1x00000000000000000000AA for development)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
